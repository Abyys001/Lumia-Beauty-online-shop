FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

# Fail fast if .output was not built locally before docker build.
COPY .output ./.output
RUN test -f .output/server/index.mjs || (echo "ERROR: run 'npm run build' in frontend/ before building this image" && exit 1)

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
