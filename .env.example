# App mode: development (hot-reload) | production (gunicorn + pre-built Nuxt .output)
APP_ENV=development

# PostgreSQL
POSTGRES_DB=lumia_beauty
POSTGRES_USER=lumia
POSTGRES_PASSWORD=lumia_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Card-to-card checkout: days before an unconfirmed order is cancelled
PENDING_ORDER_EXPIRY_DAYS=7

# Zarinpal
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=True
ZARINPAL_MOCK=True
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payments/zarinpal/verify/
ZARINPAL_CLIENT_ID=
ZARINPAL_CLIENT_SECRET=
ZARINPAL_TERMINAL_ID=

# Admin bypass (phone that gets admin access with any password)
# Leave empty in production. After changing, restart backend.
ADMIN_BYPASS_PHONE=09916122680

# Phones promoted to staff/superuser automatically (on boot and on registration)
ADMIN_PHONES=09916122680,09332279699,09166099383

# Store owner — number and name shown to customers (contact page, checkout)
OWNER_PHONE=09166099383
OWNER_NAME=خانم قراچه

# Frontend
# Dev (with docker-compose.dev.yml): Nuxt devProxy serves /api via frontend:3000
NUXT_PUBLIC_API_BASE=http://localhost:3000/api
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Dev port mapping (docker-compose.dev.yml)
FRONTEND_HTTP_PORT=3000
BACKEND_HTTP_PORT=8000

# Production only (Liara / docker compose without dev overlay)
# APP_ENV=production
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long-random-secret>
# DJANGO_ALLOWED_HOSTS=yourdomain.com,backend
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# NUXT_API_INTERNAL_URL=http://backend:8000/api
# NUXT_PUBLIC_API_BASE=https://yourdomain.com/api
# NUXT_PUBLIC_SITE_URL=https://yourdomain.com
# ZARINPAL_CALLBACK_URL=https://yourdomain.com/api/payments/zarinpal/verify/
# GUNICORN_WORKERS=2
# GUNICORN_MAX_REQUESTS=1000
# DB_CONN_MAX_AGE=600
# ADMIN_BYPASS_PHONE=

# Registry images (no `build` block on PaaS — images are pulled instead)
# BACKEND_IMAGE=siavashdev/lumia-backend:latest
# FRONTEND_IMAGE=siavashdev/lumia-frontend:latest
