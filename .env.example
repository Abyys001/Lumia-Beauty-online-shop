# PostgreSQL
POSTGRES_DB=lumia_beauty
POSTGRES_USER=lumia
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Zarinpal
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://localhost/api/payments/zarinpal/verify/

# Kavenegar SMS
KAVENEGAR_API_KEY=your-kavenegar-api-key
KAVENEGAR_TEMPLATE=verify

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost/api
NUXT_PUBLIC_SITE_URL=http://localhost
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Nginx
NGINX_HTTP_PORT=80
