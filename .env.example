# App mode: development (hot-reload) | production (gunicorn + nuxt build)
APP_ENV=development

# PostgreSQL
POSTGRES_DB=lumia_beauty
POSTGRES_USER=lumia
POSTGRES_PASSWORD=lumia_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_OTP_DEBUG_CODE=False

# Zarinpal
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=True
ZARINPAL_MOCK=True
ZARINPAL_CALLBACK_URL=http://localhost/api/payments/zarinpal/verify/
ZARINPAL_CLIENT_ID=
ZARINPAL_CLIENT_SECRET=
ZARINPAL_TERMINAL_ID=

# Admin bypass (phone that skips OTP and gets admin access instantly)
# Leave empty in production. After changing, restart backend: docker compose up -d backend
ADMIN_BYPASS_PHONE=09916122680

# Bootstrap only — overridden by Admin Panel when configured
SMS_PROVIDER=smsir
SMS_IR_API_KEY=
SMS_IR_SANDBOX_API_KEY=
SMS_IR_TEMPLATE_ID=394212
SMS_IR_BASE_URL=https://api.sms.ir/v1
SMS_IR_SANDBOX=False
IRANPAYAMAK_API_KEY=
IRANPAYAMAK_LINE_NUMBER=
IRANPAYAMAK_PATTERN_CODE=
IRANPAYAMAK_BASE_URL=https://api.iranpayamak.com
OTP_EXPIRATION_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
# Dev: disable OTP rate limits (default True when DJANGO_DEBUG=True)
OTP_DISABLE_RATE_LIMIT=True

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost/api
NUXT_PUBLIC_SITE_URL=http://localhost
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Nginx
NGINX_HTTP_PORT=80

# Production only (set APP_ENV=production and DJANGO_DEBUG=False)
# GUNICORN_WORKERS=4
