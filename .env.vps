# =============================================================================
# Production .env for VPS — lumiabeauty.ir
# On server: cp .env.vps .env   (or copy this file contents into .env)
# frontend/Dockerfile.prod builds Nuxt inside the image — no local build step needed.
# =============================================================================

APP_ENV=production

# PostgreSQL (internal Docker network — do not expose port 5432 publicly)
POSTGRES_DB=lumia_beauty
POSTGRES_USER=lumia
POSTGRES_PASSWORD=8ujVxM2JxvEFe8jPNXJpmFTsvWAKQDemOdiJJmFKpUc
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Django
DJANGO_SECRET_KEY=JrEL1-ABXvhWA4v7PUBxKRO_0ZcEPDVYUf4c5LT0b8wXRhHIWkdusB4tofDePuM0bwYFHjFlTKI66yAmtzVR4w
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lumiabeauty.ir,www.lumiabeauty.ir,backend
CSRF_TRUSTED_ORIGINS=https://lumiabeauty.ir,https://www.lumiabeauty.ir
CORS_ALLOWED_ORIGINS=https://lumiabeauty.ir,https://www.lumiabeauty.ir
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_OTP_DEBUG_CODE=False

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_MAX_REQUESTS=1000

# Zarinpal — پر کردن MERCHANT_ID با کد واقعی زرین‌پال
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=False
ZARINPAL_MOCK=False
ZARINPAL_CALLBACK_URL=https://lumiabeauty.ir/api/payments/zarinpal/verify/
ZARINPAL_CLIENT_ID=
ZARINPAL_CLIENT_SECRET=
ZARINPAL_TERMINAL_ID=

# Admin bypass — در production خالی بماند
ADMIN_BYPASS_PHONE=

# SMS (IranPayamak)
SMS_PROVIDER=iranpayamak
SMS_IR_API_KEY=
SMS_IR_SANDBOX_API_KEY=
SMS_IR_TEMPLATE_ID=394212
SMS_IR_BASE_URL=https://api.sms.ir/v1
SMS_IR_SANDBOX=False
IRANPAYAMAK_API_KEY=FrKzMGuJcHrRl7PXyUgeZLGotaoZTGJ4vrx4QsHf9aKOj4nQOz
IRANPAYAMAK_LINE_NUMBER=
IRANPAYAMAK_PATTERN_CODE=
IRANPAYAMAK_BASE_URL=https://api.iranpayamak.com
OTP_EXPIRATION_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_DISABLE_RATE_LIMIT=False

# Frontend (Nuxt SSR)
# Server-to-server: SSR requests inside the Compose network go straight to the backend container.
NUXT_API_INTERNAL_URL=http://backend:8000/api
# Browser-to-server: client-side requests go through the public domain.
NUXT_PUBLIC_API_BASE=https://lumiabeauty.ir/api
NUXT_PUBLIC_SITE_URL=https://lumiabeauty.ir
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Registry images pulled by `docker compose pull` / `docker compose up -d` (no local build on PaaS)
BACKEND_IMAGE=siavashdev/lumia-backend:latest
FRONTEND_IMAGE=siavashdev/lumia-frontend:latest
